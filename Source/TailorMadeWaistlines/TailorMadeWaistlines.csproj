<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TailorMadeWaistlines</AssemblyName>
    <RootNamespace>TailorMadeWaistlines</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Configuration>Release</Configuration>
    <OutputPath>..\..\Mod\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS0169;CS0649;CS0414;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- TailorMade is MIT. Referenced, never redistributed: Private=false keeps
         its assembly out of our output folder. -->
    <Reference Include="TailorMadeUnifiedApparelBodyRefitting">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3756915448\Assemblies\TailorMadeUnifiedApparelBodyRefitting.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
