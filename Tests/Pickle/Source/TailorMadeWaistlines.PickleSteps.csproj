<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Step definitions for the feature files in ../Mod/Pickle/Features. Only Pickle loads this
    assembly: it lives in the companion test mod, never in the Mod/ folder that goes to the
    Workshop.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TailorMadeWaistlines.PickleSteps</AssemblyName>
    <RootNamespace>TailorMadeWaistlines.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time stubs only: the game, Harmony and the Pickle mod supply the real assemblies. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both bound by name at run time, and neither redistributed: RimWorld loads the mod and
         TailorMade before Pickle loads this assembly. Build the mod first. -->
    <Reference Include="TailorMadeWaistlines">
      <HintPath>..\..\..\Mod\Assemblies\TailorMadeWaistlines.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TailorMadeUnifiedApparelBodyRefitting">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3756915448\Assemblies\TailorMadeUnifiedApparelBodyRefitting.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
