<Project>

  <PropertyGroup>
    <!-- Intermediates stay out of the test mod folder, as they do for the shipped mod: what sits
         beside About.xml is what a Mods folder gets linked to. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\.build\pickle\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\..\.build\pickle\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
