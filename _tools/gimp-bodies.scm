;
; GENERATED by _tools/make-gimp-bodies.js - edit that, not this.
;
; In GIMP: Filters > Script-Fu > Console, then
;
;   (load "C:/Users/nelim/Documents/rimworld/TailoredPants/_tools/gimp-bodies.scm")
;   (tb-open "Female" "south")    ; one body type, one facing
;   (tb-open-body "Female")       ; its three facings
;
; One layer per mod, the first visible and the rest hidden. Toggle down the
; stack to see how far the silhouettes drift apart: where two mods agree, a
; fix written for one of them can be reused for the other.
;
; Set a layer to Difference mode against the one below to see the drift
; directly - black means the two are the same pixel.
;
; No vanilla layer: RimWorld ships no loose body textures, they live inside
; the engine's asset bundles.

(define (tb-one v) (if (pair? v) (car v) v))

(define (tb-exists? file)
  (let ((r (file-exists? file)))
    (cond ((pair? r) (= (car r) TRUE))
          ((number? r) (= r TRUE))
          (else r))))

(define (tb-add image file name visible)
  (if (tb-exists? file)
      (let ((layer (tb-one (gimp-file-load-layer RUN-NONINTERACTIVE image file))))
        (gimp-image-insert-layer image layer 0 0)
        (gimp-item-set-name layer name)
        (gimp-item-set-visible layer visible)
        layer)
      #f))

