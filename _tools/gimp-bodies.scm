(define (tb-entry body facing)
  (let loop ((rows tb-table))
    (cond ((null? rows) #f)
          ((and (string=? (car (car rows)) body)
                (string=? (cadr (car rows)) facing))
           (cddr (car rows)))
          (else (loop (cdr rows))))))

(define (tb-build body facing)
  (let ((entry (tb-entry body facing)))
    (if (not entry)
        (begin (gimp-message "no body texture for that combination") #f)
        (let ((image (tb-one (gimp-image-new 512 512 RGB)))
              (first TRUE))
          (for-each
            (lambda (pair)
              (tb-add image (cdr pair) (car pair) first)
              (set! first FALSE))
            entry)
          image))))

(define (tb-open body facing)
  (let ((image (tb-build body facing)))
    (if image (begin (gimp-display-new image) (gimp-displays-flush)))
    image))

(define (tb-open-body body)
  (for-each (lambda (f) (tb-open body f)) (list "south" "north" "east")))
